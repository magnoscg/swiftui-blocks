---
// The top of the page of a component: its preview on a stage, what it needs,
// and the ways to add it. Copying the code reads it from the block titled
// with the name of the Swift file, below, so the page holds one copy of the
// source.
import { TabItem, Tabs } from '@astrojs/starlight/components';
import { cardURL, categoryURL, components, fileURL, pageURL, previewURL, REPOSITORY, SITE_BASE } from '../lib/catalog';

interface Props {
  id: string;
  lines: number;
}

const component = components.find((candidate) => candidate.id === Astro.props.id);
if (!component) throw new Error(`No component with the id "${Astro.props.id}" in catalog.json.`);

const { name, title, summary, category, minIOS, difficulty, apis, origin, path, shader, rawURL, shaderRawURL } = component;
const keywords = [...component.keywords.en, ...component.keywords.es];
// The address of an origin comes from the metadata as written. Only a web address becomes a link.
const originURL = 'url' in origin && /^https?:\/\//.test(origin.url) ? origin.url : undefined;
const originLabel = { original: 'Original work', inspired: 'Inspired', adapted: 'Adapted' }[origin.kind];
const ask = `Add the ${title} from SwiftUI Blocks`;

// What a coding agent needs to add the component without opening this page.
const prompt = [
  `Add the SwiftUI component "${title}" to my project.`,
  `Download ${rawURL} into a new file named ${name}.swift and keep its license header.`,
  shaderRawURL
    ? `It draws with a Metal shader: also download ${shaderRawURL} into ${name}.metal, in the same target.`
    : undefined,
  `Check that each file starts with // SPDX-License-Identifier: MIT and that ${name}.swift ends with the three lines of its #Preview; if not, delete it and tell me.`,
  `It needs iOS ${minIOS} or later, so compare that with my deployment target first.`,
  `Its ${name}Demo view and its #Preview show how it is used. Use it where I ask, then remove the demo and the preview.`,
]
  .filter((line) => line !== undefined)
  .join('\n');

// What search engines read about the component: its code, and where it sits in the catalog.
const pageAddress = new URL(pageURL(component), Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareSourceCode',
      name: title,
      description: summary,
      url: pageAddress,
      image: previewURL(component),
      codeRepository: REPOSITORY,
      programmingLanguage: 'Swift',
      runtimePlatform: `iOS ${minIOS}`,
      license: 'https://opensource.org/licenses/MIT',
      keywords: keywords.join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: 'Catalog', path: `${SITE_BASE}/catalog/` },
        { name: category, path: categoryURL(category) },
        { name: title, path: pageURL(component) },
      ].map(({ name, path }, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name,
        item: new URL(path, Astro.site).href,
      })),
    },
  ],
};
// A summary holding "</script>" would otherwise close the block early.
const structuredDataJSON = JSON.stringify(structuredData).replaceAll('<', '\\u003c');
---

<script type="application/ld+json" is:inline set:html={structuredDataJSON} />

<section class="component-header not-content">
  <p class="summary">{summary}</p>

  <ul class="facts">
    <li>iOS {minIOS.replace(/\.0$/, '')}+</li>
    <li class="level">{difficulty}</li>
    <li>{originLabel}</li>
  </ul>

  <div class="columns">
    <figure class="preview">
      <div class="stage" data-stage>
        <span class="screen">
          <picture>
            <source media="(prefers-reduced-motion: reduce)" srcset={cardURL(component)} />
            <img
              src={previewURL(component)}
              alt={`Preview of ${title}`}
              width="320"
              height="696"
              decoding="async"
              data-still={cardURL(component)}
            />
          </picture>
        </span>
        <button type="button" class="pause" data-stage-pause>
          <svg class="pause-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="currentColor">
            <rect x="6" y="5" width="4" height="14" rx="1"></rect>
            <rect x="14" y="5" width="4" height="14" rx="1"></rect>
          </svg>
          <svg class="play-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="currentColor">
            <path d="M7 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L8.5 4.64A1 1 0 0 0 7 5.5Z"></path>
          </svg>
          <span data-stage-label>Pause</span>
        </button>
      </div>
      <figcaption>Recorded in the iOS Simulator</figcaption>
    </figure>

    <div class="add-it">
      <h2>Add it</h2>
      <Tabs syncKey="add-it">
        <TabItem label="With your agent">
          <p>Paste it into any coding agent. It carries the download link and the checks, so no skill is needed.</p>
          <div class="actions">
            <button type="button" class="primary" data-copy={prompt} data-done="Copied">Copy full prompt</button>
          </div>
          <p class="ask-label">Skill installed? Just ask:</p>
          <p class="ask">
            <span>“{ask}”</span>
            <button type="button" data-copy={ask} data-done="Copied" aria-label="Copy the request">
              <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <rect x="9" y="9" width="12" height="12" rx="2"></rect>
                <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
              </svg>
              <span class="sr-only" data-copy-label>Copy</span>
            </button>
          </p>
        </TabItem>
        <TabItem label="By hand">
          <div class="actions">
            <button type="button" class="primary" data-copy-code={`${name}.swift`} data-done="Copied">Copy code</button>
            <a href={fileURL(path)} download={`${name}.swift`}>Download .swift</a>
            {shader && <a href={fileURL(shader)} download={`${name}.metal`}>Download .metal</a>}
          </div>
          <p>{shaderRawURL ? 'Two files: add both to the same target.' : 'Add the file to your app target in Xcode.'}</p>
        </TabItem>
      </Tabs>

      <dl>
        <div>
          <dt>File</dt>
          <dd>{shaderRawURL ? 'Two files · .swift + .metal' : `One file · ${Astro.props.lines} lines`}</dd>
        </div>
        <div>
          <dt>Uses</dt>
          <dd class="apis">
            {
              apis.map((api) => (
                <a href={`${SITE_BASE}/catalog/?api=${encodeURIComponent(api)}`}>
                  <code>{api}</code>
                </a>
              ))
            }
          </dd>
        </div>
        <div>
          <dt>Origin</dt>
          <dd>
            {origin.kind === 'original' && 'Original work'}
            {
              origin.kind === 'inspired' && (
                <>
                  Inspired by {originURL ? <a href={originURL}>{origin.credit}</a> : origin.credit}, written from scratch
                </>
              )
            }
            {
              origin.kind === 'adapted' && (
                <>
                  Adapted from {originURL ? <a href={originURL}>its source</a> : 'its source'}, {origin.license}
                </>
              )
            }
          </dd>
        </div>
        <div>
          <dt>Found by</dt>
          <dd class="keywords">{keywords.join(' · ')}</dd>
        </div>
      </dl>
    </div>
  </div>
  <p class="sr-only" role="status" data-copy-status></p>
</section>

<script>
  import '../lib/copy';
  import '../lib/code-fold';
  import '../lib/code-scroll';
  import { showStill, trackStill } from '../lib/still';

  for (const stage of document.querySelectorAll<HTMLElement>('[data-stage]')) {
    const image = stage.querySelector<HTMLImageElement>('img[data-still]');
    const button = stage.querySelector<HTMLButtonElement>('[data-stage-pause]');
    const label = stage.querySelector<HTMLElement>('[data-stage-label]');
    if (!image) continue;
    trackStill(image);
    button?.addEventListener('click', () => {
      const paused = stage.toggleAttribute('data-paused');
      if (label) label.textContent = paused ? 'Play' : 'Pause';
      showStill(image, paused);
    });
  }
</script>

<style>
  .component-header {
    container-type: inline-size;
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .summary {
    max-width: 44rem;
    font-size: var(--sl-text-lg);
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-1);
  }

  .facts .level {
    text-transform: capitalize;
  }

  .columns {
    display: grid;
    gap: 1.5rem;
  }

  /* With room, the stage stands beside the ways to add the component. */
  @container (min-width: 36rem) {
    .columns {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
      align-items: start;
    }
  }

  @container (min-width: 46rem) {
    .columns {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    }
  }

  .preview {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  figcaption {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-align: center;
  }

  /* The preview stands on a field of dots, lit from above, like a thing on a table. */
  .stage {
    display: grid;
    place-items: center;
    gap: 1rem;
    padding: clamp(1.25rem, 5cqi, 2.5rem);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1.25rem;
    background:
      radial-gradient(24rem 14rem at 50% 0, color-mix(in srgb, var(--sl-color-white) 7%, transparent), transparent 70%),
      radial-gradient(circle, var(--sl-color-gray-5) 1px, transparent 1.5px) 0 0 / 1.25rem 1.25rem,
      var(--sl-color-gray-6);
  }

  .screen {
    display: block;
    width: min(100%, 13rem);
    overflow: hidden;
    border-radius: 2rem;
    border: 1px solid var(--sl-color-gray-5);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7);
  }

  .screen img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 320 / 696;
    object-fit: cover;
  }

  /* A social card holds the phone 580 px tall in 630: this fills the screen with it. */
  .screen img.still {
    scale: 1.0862;
  }

  .pause {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.7rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-1);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    cursor: pointer;
  }

  .pause:hover {
    border-color: var(--sl-color-gray-3);
  }

  .play-icon,
  [data-paused] .pause-icon {
    display: none;
  }

  [data-paused] .play-icon {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .pause {
      display: none;
    }

    .screen img {
      scale: 1.0862;
    }
  }

  .add-it {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1.25rem;
  }

  .add-it h2 {
    margin: 0;
    font-size: var(--sl-text-h4);
    color: var(--sl-color-white);
  }

  .add-it p {
    margin: 0.75rem 0 0;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  .add-it :global([role='tab']) {
    position: relative;
    padding-inline: 0.75rem;
    box-shadow: none;
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }

  .add-it :global([role='tab'][aria-selected='true']) {
    font-weight: 500;
  }

  .add-it :global([role='tab'][aria-selected='true'])::after {
    content: '';
    position: absolute;
    inset: auto 0.75rem 0;
    height: 2px;
    border-radius: 2px;
    background: var(--brand-gradient);
  }

  .actions,
  .apis {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .actions {
    margin-top: 0.75rem;
  }

  .actions > * {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.7rem;
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .actions > *:hover {
    border-color: var(--sl-color-gray-3);
  }

  .actions .primary {
    border-color: var(--sl-color-white);
    color: var(--sl-color-black);
    background: var(--sl-color-white);
  }

  .actions [data-copied],
  .ask [data-copied] {
    border-color: var(--brand-2);
  }

  .add-it .ask-label {
    margin-top: 1rem;
  }

  .add-it .ask {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.25rem 0.25rem 0.25rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.7rem;
    color: var(--sl-color-white);
  }

  .ask button {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    background: none;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }

  .ask button:hover {
    color: var(--sl-color-white);
  }

  dl {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  dt {
    margin-bottom: 0.3rem;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  dd {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    overflow-wrap: anywhere;
  }

  dd a {
    color: var(--sl-color-white);
  }

  .apis a {
    text-decoration: none;
  }

  .apis code {
    padding: 0.15rem 0.5rem;
    border-radius: 0.4rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-1);
    background: var(--sl-color-gray-5);
  }

  .apis a:hover code {
    color: var(--sl-color-white);
  }

  .keywords {
    line-height: 1.7;
    color: var(--sl-color-gray-3);
  }

  @media (pointer: coarse) {
    .add-it :global([role='tab']) {
      min-height: 2.75rem;
    }
  }

  @media (forced-colors: active) {
    .add-it :global([role='tab'][aria-selected='true'])::after {
      background: none;
      border-block-end: 2px solid CanvasText;
    }
  }
</style>
