---
// The agents of /install/, each with its steps. Its tabs share their choice with the install box of the landing page.
import { Code, Steps, TabItem, Tabs } from '@astrojs/starlight/components';
import { byHand, installAgents } from '../lib/install';
---

<div class="install-agents">
  <Tabs syncKey="agent">
    {
      installAgents.map((way, index) => (
        <TabItem label={way.label}>
          <p class="via">
            {way.via}
            {index === 0 && <span class="recommended">Recommended</span>}
          </p>
          <Steps>
            <ol>
              <li>
                <p class="step">Run in your terminal</p>
                <Code code={way.commands.join('\n')} lang="sh" wrap hangingIndent={2} />
                {way.label === 'Cursor' ? (
                  <p>It asks which agents to set up: pick Cursor. It needs Node.</p>
                ) : (
                  way.kind === 'skills-cli' && (
                    <p>
                      It asks which agents to set up, and whether for this project or for all of them. To answer up
                      front, add <code>-g</code> for every project and <code>-a</code> with an agent, like{' '}
                      <code>-a claude-code</code> or <code>-a codex</code>. It needs Node.
                    </p>
                  )
                )}
              </li>
              <li>
                <p class="step">Start a new session</p>
                <p>
                  Your agent loads skills when a session starts.
                  {way.check && (
                    <>
                      {' '}
                      Then <code>{way.check.command}</code> lists <code>{way.check.shows}</code>.
                    </>
                  )}
                </p>
              </li>
              <li>
                <p class="step">Ask</p>
                <p>
                  “Which SwiftUI Blocks loaders work on iOS 18?” It should search the catalog and name loaders such as
                  Orbit Loader, Dots Pulse Loader and Wave Bars Loader.
                </p>
              </li>
              <li>
                <p class="step">Keep it up to date</p>
                <Code code={way.update.join('\n')} lang="sh" wrap hangingIndent={2} />
              </li>
            </ol>
          </Steps>
          {way.kind === 'skills-cli' && (
            <details id={index === 0 ? 'by-hand' : undefined}>
              <summary>No Node? Copy the skill by hand</summary>
              {byHand
                .filter((copy) => way.label !== 'Cursor' || copy.agents.includes('Cursor'))
                .map((copy) => (
                  <>
                    <p>{copy.agents}:</p>
                    <Code code={copy.command} lang="sh" wrap hangingIndent={2} />
                  </>
                ))}
              <p>
                For one project only, use{' '}
                {way.label === 'Cursor' ? (
                  <code>.agents/skills/</code>
                ) : (
                  <>
                    <code>.claude/skills/</code> or <code>.agents/skills/</code>
                  </>
                )}{' '}
                inside the project instead.
              </p>
            </details>
          )}
        </TabItem>
      ))
    }
  </Tabs>
</div>

<script>
  import { agentId } from '../lib/install';

  // /install/#codex opens the tab of Codex, and /install/#by-hand the copy by hand under Any agent.
  const open = () => {
    const hash = decodeURIComponent(location.hash.slice(1));
    const id = hash === 'by-hand' ? 'any-agent' : hash;
    const tab = [...document.querySelectorAll<HTMLElement>('.install-agents [role="tab"]')].find(
      (candidate) => agentId(candidate.textContent?.trim() ?? '') === id,
    );
    if (!tab) return;
    if (tab.getAttribute('aria-selected') !== 'true') tab.click();
    const target = hash === 'by-hand' ? document.getElementById('by-hand') : tab.closest('starlight-tabs');
    if (target instanceof HTMLDetailsElement) target.open = true;
    target?.scrollIntoView();
  };

  customElements.whenDefined('starlight-tabs').then(open);
  addEventListener('hashchange', open);
</script>

<style>
  @property --fade-start {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  @property --fade-end {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  .install-agents :global(.tablist-wrapper) {
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .install-agents :global([role='tablist']) {
    --fade-size: 2.5rem;
    gap: 0.125rem;
    margin: 0;
    padding: 0.375rem 0;
    border: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    scroll-padding-inline: var(--fade-size);
  }

  /* On a narrow screen the tabs scroll, and each edge fades while there are more tabs beyond it.
     Without scroll-driven animations the fades would stay on, so those browsers go without. */
  @supports (animation-timeline: scroll()) {
    .install-agents :global([role='tablist']) {
      mask:
        linear-gradient(black, black) no-clip subtract,
        linear-gradient(to right, black, transparent) 0 0 / var(--fade-start) 100% no-repeat no-clip,
        linear-gradient(to right, transparent, black) 100% 0 / var(--fade-end) 100% no-repeat no-clip;
      animation:
        install-agents-fade-start linear both,
        install-agents-fade-end linear both;
      animation-timeline: scroll(self inline);
      animation-range:
        0 var(--fade-size),
        calc(100% - var(--fade-size)) 100%;
    }
  }

  @keyframes install-agents-fade-start {
    to {
      --fade-start: var(--fade-size);
    }
  }

  @keyframes install-agents-fade-end {
    from {
      --fade-end: var(--fade-size);
    }
  }

  .install-agents :global(.tab) {
    flex: none;
  }

  .install-agents :global([role='tab']) {
    position: relative;
    min-height: 2.125rem;
    padding: 0 0.75rem;
    border-radius: 0.5rem;
    box-shadow: none;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-gray-2);
  }

  .install-agents :global([role='tab'][aria-selected='true']) {
    font-weight: 500;
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }

  .install-agents :global([role='tab'][aria-selected='true'])::after {
    content: '';
    position: absolute;
    inset: auto 0.75rem -0.375rem;
    height: 2px;
    border-radius: 2px;
    background: var(--brand-gradient);
  }

  .via {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .recommended {
    padding: 0 0.5rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background:
      linear-gradient(var(--sl-color-bg), var(--sl-color-bg)) padding-box,
      var(--brand-gradient) border-box;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .step {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  /* A command never hides behind a scroll: a long address breaks where it has to. */
  .install-agents :global(.expressive-code .ec-line .code) {
    overflow-wrap: anywhere;
  }

  .install-agents p code {
    white-space: nowrap;
  }

  details {
    margin-top: 1.5rem;
  }

  summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  @media (pointer: coarse) {
    .install-agents :global([role='tab']) {
      min-height: 2.75rem;
    }
  }

  @media (forced-colors: active) {
    .install-agents :global([role='tab'][aria-selected='true'])::after {
      background: none;
      border-block-end: 2px solid CanvasText;
    }
  }
</style>
