---
// Prompts that work, grouped by what people want, each with the component it
// finds. Only the ids live here: the title and the category come from
// catalog.json, so a renamed component fails the build instead of the page.
import { components, pageURL } from '../lib/catalog';

const groups = [
  {
    title: 'Make it feel alive',
    prompts: [
      ['Add a like button that bursts into hearts', 'like-burst-button'],
      ['Make the delete button fire only after a long press', 'hold-to-confirm-button'],
      ['Throw confetti when the order goes through', 'confetti-burst'],
    ],
  },
  {
    title: 'Onboard and sell',
    prompts: [
      ['Add a three-page onboarding with a Continue button', 'onboarding-pager'],
      ['Build a paywall that shows what happens each day of the trial', 'trial-timeline-paywall'],
      ['Show what this version brings, once per version', 'whats-new-sheet'],
    ],
  },
  {
    title: 'Show the numbers',
    prompts: [
      ['Show my three daily goals as activity rings', 'activity-rings'],
      ['Add a line chart I can scrub with a finger', 'interactive-line-chart'],
      ['A calendar heatmap of my daily streak', 'contribution-heatmap'],
    ],
  },
  {
    title: 'Use the newest iOS',
    prompts: [
      ['Group my editing tools in a Liquid Glass strip', 'glass-tool-strip'],
      ['Let the tab bar shrink while I scroll', 'minimizing-tab-bar'],
      ['Fill a form from a free-form note with the on-device model', 'structured-output-form'],
    ],
  },
].map((group) => ({
  ...group,
  prompts: group.prompts.map(([prompt, id]) => {
    const component = components.find((candidate) => candidate.id === id);
    if (!component) throw new Error(`PromptGallery names "${id}", which is not in catalog.json.`);
    return { prompt, component };
  }),
}));
---

<div class="prompt-gallery not-content">
  {
    groups.map((group) => (
      <section>
        <h3>{group.title}</h3>
        <ul>
          {group.prompts.map(({ prompt, component }) => (
            <li>
              <p class="prompt">{prompt}</p>
              <p class="finds">
                <a href={pageURL(component)}>{component.title}</a>
                <span>{component.minIOS === '18.0' ? component.category : `iOS ${component.minIOS.replace('.0', '')}`}</span>
                <button type="button" data-copy={prompt} data-done="Copied" aria-label={`Copy the prompt: ${prompt}`}>
                  Copy
                </button>
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <p class="sr-only" role="status" data-copy-status></p>
</div>

<script>
  import '../lib/copy';
</script>

<style>
  .prompt-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2.5rem;
    margin-top: 1.5rem;
  }

  /* Four groups: two rows of two, or one column on a phone, never a group alone in a row. */
  @media (max-width: 40rem) {
    .prompt-gallery {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  section {
    min-width: 0;
  }

  h3 {
    margin: 0 0 0.3rem;
    font-family: var(--sl-font);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.8rem 0;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .prompt {
    margin: 0;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }

  .prompt::before {
    content: '“';
  }

  .prompt::after {
    content: '”';
  }

  .finds {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.35rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .finds a {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--sl-color-gray-2);
    font-family: var(--__sl-font-mono);
    text-decoration: none;
  }

  .finds a:hover,
  .finds a:focus-visible {
    color: var(--sl-color-white);
    text-decoration: underline;
  }

  button {
    position: relative;
    margin-left: auto;
    min-height: 2rem;
    padding: 0 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    cursor: pointer;
  }

  /* Wider than it looks, so it answers in 44 points. */
  button::after {
    content: '';
    position: absolute;
    inset: -0.375rem;
  }

  button:hover,
  button:focus-visible {
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-white);
  }
</style>
