---
// The install command of the landing page. Its tabs share their choice with the ones of /install/.
import { TabItem, Tabs } from '@astrojs/starlight/components';
import { installWays, SKILL_URL } from '../lib/install';
import { SITE_BASE } from '../lib/catalog';
import { landingText, type LandingLang } from '../lib/landing';

interface Props {
  lang?: LandingLang;
}

const text = landingText[Astro.props.lang ?? 'en'];

// A phone breaks a command before its last word, unless that word alone is wider than the box.
const split = (command: string) => {
  const at = command.lastIndexOf(' ');
  const last = command.slice(at + 1);
  return last.length <= 32 ? { head: command.slice(0, at + 1), tail: last } : { head: command, tail: '' };
};
---

<div class="install-box not-content">
  <Tabs syncKey="agent">
    {
      installWays.map((way) => (
        <TabItem label={way.kind === 'skills-cli' ? text.anyAgent : way.label}>
          <div class="command">
            <code>
              {way.commands.map((command) => {
                const { head, tail } = split(command);
                return (
                  <span class="line">
                    <span class="prompt" aria-hidden="true">$</span>
                    {head}
                    {tail && <span class="nowrap">{tail}</span>}
                  </span>
                );
              })}
            </code>
            <button
              type="button"
              class="copy"
              data-copy={way.commands.join(' && ')}
              data-done={text.copied}
              aria-label={way.commands.length > 1 ? text.copyCommands : text.copyCommand}
            >
              <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                <rect x="9" y="9" width="12" height="12" rx="2" />
                <path d="M5 15V5a2 2 0 0 1 2-2h10" />
              </svg>
              <span data-copy-label>{text.copy}</span>
            </button>
          </div>
          {way.kind === 'skills-cli' ? (
            <p class="note">
              {text.skillsNote} <a href={`${SITE_BASE}/install/#by-hand`}>{text.skillsByHand}</a>.{' '}
              <a href={SKILL_URL}>{text.readSkill}</a>
            </p>
          ) : (
            <p class="note">
              {text.pluginNote} <a href={`${SITE_BASE}/install/`}>{text.allOptions}</a>
            </p>
          )}
        </TabItem>
      ))
    }
  </Tabs>
  <p class="sr-only" role="status" data-copy-status></p>
</div>

<script>
  import '../lib/copy';
</script>

<style>
  @property --fade-start {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  @property --fade-end {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  .install-box {
    width: 100%;
    max-width: 45rem;
    margin-inline: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.875rem;
    background: var(--sl-color-gray-6);
    text-align: start;
    overflow: hidden;
  }

  .install-box :global(.tablist-wrapper) {
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .install-box :global([role='tablist']) {
    --fade-size: 2.5rem;
    gap: 0.125rem;
    margin: 0;
    padding: 0.375rem;
    border: 0;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-padding-inline: var(--fade-size);
  }

  /* On a narrow screen the tabs scroll, and each edge fades while there are more tabs beyond it.
     Without scroll-driven animations the fades would stay on, so those browsers go without. */
  @supports (animation-timeline: scroll()) {
    .install-box :global([role='tablist']) {
      mask:
        linear-gradient(black, black) no-clip subtract,
        linear-gradient(to right, black, transparent) 0 0 / var(--fade-start) 100% no-repeat no-clip,
        linear-gradient(to right, transparent, black) 100% 0 / var(--fade-end) 100% no-repeat no-clip;
      animation:
        install-box-fade-start linear both,
        install-box-fade-end linear both;
      animation-timeline: scroll(self inline);
      animation-range:
        0 var(--fade-size),
        calc(100% - var(--fade-size)) 100%;
    }
  }

  @keyframes install-box-fade-start {
    to {
      --fade-start: var(--fade-size);
    }
  }

  @keyframes install-box-fade-end {
    from {
      --fade-end: var(--fade-size);
    }
  }

  .install-box :global(.tab) {
    flex: none;
  }

  .install-box :global([role='tab']) {
    position: relative;
    min-height: 2.125rem;
    padding: 0 0.75rem;
    border-radius: 0.5rem;
    box-shadow: none;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-gray-2);
  }

  .install-box :global([role='tab'][aria-selected='true']) {
    font-weight: 500;
    color: var(--sl-color-white);
    background: var(--sl-color-gray-5);
  }

  .install-box :global([role='tab'][aria-selected='true'])::after {
    content: '';
    position: absolute;
    inset: auto 0.75rem -0.4375rem;
    height: 2px;
    border-radius: 2px;
    background: var(--brand-gradient);
  }

  .install-box :global([role='tabpanel']) {
    margin: 0;
  }

  .command {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.625rem 0.75rem 1.125rem;
  }

  code {
    flex: 1;
    min-width: 0;
    padding: 0;
    background: none;
    font-family: var(--__sl-font-mono);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--sl-color-white);
    overflow-wrap: anywhere;
  }

  .line {
    display: block;
  }

  .nowrap {
    white-space: nowrap;
  }

  .prompt {
    margin-inline-end: 0.625rem;
    color: var(--sl-color-gray-3);
    user-select: none;
  }

  .copy {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.375rem;
    padding: 0 0.875rem;
    border: 0;
    border-radius: 0.5625rem;
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .note {
    margin: 0;
    padding: 0.625rem 1.125rem 0.75rem;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }

  .note a {
    color: var(--sl-color-gray-1);
    text-decoration: underline;
    text-decoration-color: var(--brand-2);
    text-underline-offset: 0.2em;
  }

  @media (pointer: coarse) {
    .install-box :global([role='tab']),
    .copy {
      min-height: 2.75rem;
    }
  }

  @media (forced-colors: active) {
    .install-box :global([role='tab'][aria-selected='true'])::after {
      background: none;
      border-block-end: 2px solid CanvasText;
    }
  }

  @media (max-width: 40rem) {
    .command {
      flex-wrap: wrap;
      padding: 0.75rem 0.75rem 0.75rem 0.875rem;
    }

    code {
      flex-basis: 100%;
      font-size: 0.875rem;
    }

    .copy {
      width: 100%;
      min-height: 2.75rem;
    }

    .note {
      padding-inline: 0.875rem;
    }
  }
</style>
