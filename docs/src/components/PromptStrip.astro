---
// The prompts that work, in two rows that drift in opposite directions under the hero: what someone asks,
// the component playing, and the file it adds. Every card runs the whole loop on its own, one slot after the
// previous one, so a row needs no copies to come back at the other edge. Both rows play every card, the second
// from halfway, so they never line up. Focusing a card holds the strip; with Reduce Motion it stands
// still, scrolls by hand, and each card shows the still of its social card, the middle frame of the preview.
import { cardURL, pageURL, previewBytes, previewURL } from '../lib/catalog';
import { landingText, type LandingLang } from '../lib/landing';
import { promptGroups } from '../lib/prompts';

interface Props {
  lang?: LandingLang;
}

const text = landingText[Astro.props.lang ?? 'en'];

// A preview can weigh up to 2 MB. The landing page keeps to the light ones.
const maximumBytes = 700 * 1024;
const cards = promptGroups
  .flatMap((group) => group.prompts)
  .filter(({ component }) => previewBytes(component) <= maximumBytes);
// Fewer cards than this leave a gap in the loop on the widest screens, so the list plays twice.
const filled = (row: typeof cards) => (row.length < 16 ? [...row, ...row] : row);
const half = Math.ceil(cards.length / 2);
const rows = [filled(cards), filled([...cards.slice(half), ...cards.slice(0, half)])];
// The fraction of the loop each card has already run, so that card i starts in slot i whichever way its row drifts.
const offset = (index: number, count: number, reverse: boolean) => (reverse ? index + 1 : count - 1 - index) / count;
---

<section class="prompt-strip not-content" aria-labelledby="prompt-strip-title" data-prompt-strip>
  <h2 id="prompt-strip-title">{text.stripTitle}</h2>
  <div class="viewport">
    {
      rows.map((row, rowIndex) => {
        const reverse = rowIndex === 1;
        return (
          <ul class:list={{ reverse }} style={`--count: ${row.length}`} aria-hidden={reverse ? 'true' : undefined}>
            {row.map(({ prompt, component }, index) => {
              const copy = reverse || index >= cards.length;
              return (
                <li style={`--offset: ${offset(index, row.length, reverse)}`} aria-hidden={copy && !reverse ? 'true' : undefined} class:list={{ copy }}>
                  <p class="ask">“{prompt}”</p>
                  <a href={pageURL(component)} tabindex={copy ? -1 : undefined}>
                    <picture>
                      <source media="(prefers-reduced-motion: reduce)" srcset={cardURL(component)} />
                      <img
                        src={previewURL(component)}
                        alt={component.title}
                        width="192"
                        height="417"
                        loading="lazy"
                        decoding="async"
                        data-still={cardURL(component)}
                      />
                    </picture>
                    {component.minIOS !== '18.0' && <span class="ios">iOS {component.minIOS.replace('.0', '')}</span>}
                  </a>
                  <p class="adds">
                    <span aria-hidden="true">+ </span>
                    {component.name}
                    <wbr />
                    .swift
                  </p>
                </li>
              );
            })}
          </ul>
        );
      })
    }
  </div>
</section>

<script>
  for (const strip of document.querySelectorAll<HTMLElement>('[data-prompt-strip]')) {
    const viewport = strip.querySelector<HTMLElement>('.viewport');
    const images = [...strip.querySelectorAll<HTMLImageElement>('img[data-still]')];
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

    // The still is scaled only once it has loaded, so the moving preview never shows enlarged, nor the still bare.
    for (const image of images) {
      image.addEventListener('load', () => image.classList.toggle('still', image.currentSrc === image.dataset.still));
    }

    // Focus scrolls the hidden overflow to show a card; once it leaves, the row goes back to its place.
    strip.addEventListener('focusout', (event) => {
      if (reduceMotion.matches || !viewport || strip.contains(event.relatedTarget as Node | null)) return;
      viewport.scrollLeft = 0;
    });
  }
</script>

<style>
  .prompt-strip {
    --gap: 1.125rem;
    --card-width: 12rem;
    --ask-height: 4.375rem;
    --shot-height: calc(var(--card-width) * 874 / 402);
    --slot: calc(var(--card-width) + var(--gap));
    margin: 3rem calc(50% - 50vw) 0;
  }

  h2 {
    max-width: 96rem;
    margin: 0 auto 0.875rem;
    padding-inline: max(1rem, 2vw);
    font-family: var(--sl-font);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--sl-color-gray-3);
  }

  .viewport {
    display: grid;
    gap: 1.5rem;
    padding-block: 0.25rem;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
  }

  ul {
    --loop: calc(var(--count) * var(--slot));
    --duration: calc(var(--count) * 9.4s);
    position: relative;
    height: calc(var(--ask-height) + 0.625rem + var(--shot-height) + 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: absolute;
    inset-block-start: 0;
    left: 0;
    width: var(--card-width);
  }

  .ask {
    display: flex;
    align-items: center;
    height: var(--ask-height);
    margin: 0 0 0.625rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.875rem 0.875rem 0.875rem 0.25rem;
    background: var(--sl-color-gray-6);
    font-size: 0.8125rem;
    line-height: 1.38;
    color: var(--sl-color-gray-1);
    box-sizing: border-box;
  }

  a {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--sl-color-white) 14%, transparent);
    border-radius: 1.75rem;
    background: var(--sl-color-gray-6);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.55);
    outline-offset: 3px;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 402 / 874;
    object-fit: cover;
  }

  /* A social card holds the phone 580 px tall in 630: this fills the card with it. */
  img.still {
    scale: 1.0862;
  }

  .ios {
    position: absolute;
    inset-block-start: 0.625rem;
    inset-inline-start: 0.625rem;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: rgb(10 10 10 / 0.82);
    font-size: 0.6875rem;
    font-weight: 600;
    color: #fafafa;
  }

  .adds {
    margin: 0.5625rem 0 0 0.25rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--sl-color-gray-2);
    overflow-wrap: break-word;
  }

  @media (prefers-reduced-motion: no-preference) {
    li {
      animation: prompt-strip-drift var(--duration) linear infinite;
      animation-delay: calc(var(--duration) * var(--offset) * -1);
    }

    a {
      transition: transform 0.25s ease;
    }

    a:hover,
    a:focus-visible {
      transform: translateY(-4px) scale(1.02);
    }

    ul.reverse li {
      animation-direction: reverse;
    }

    /* Only focus holds the strip, so a card reached with the keyboard stays put; the pointer does not. */
    .prompt-strip:focus-within li {
      animation-play-state: paused;
    }

    .prompt-strip:focus-within .viewport {
      mask-image: none;
    }
  }

  @keyframes prompt-strip-drift {
    from {
      transform: translateX(calc(var(--loop) - var(--slot)));
    }
    to {
      transform: translateX(calc(var(--slot) * -1));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ul.reverse,
    li.copy {
      display: none;
    }

    .viewport {
      overflow-x: auto;
      mask-image: none;
      scroll-snap-type: inline proximity;
      scroll-padding-inline: max(1rem, 2vw);
    }

    ul {
      display: flex;
      gap: var(--gap);
      width: max-content;
      height: auto;
      padding-inline: max(1rem, 2vw);
    }

    li {
      position: static;
      scroll-snap-align: start;
    }

    img {
      scale: 1.0862;
    }
  }

  @media (max-width: 40rem) {
    .prompt-strip {
      --card-width: 9.75rem;
      --ask-height: 5.25rem;
      margin-top: 2.5rem;
    }

    .ask {
      font-size: 0.75rem;
    }
  }
</style>
